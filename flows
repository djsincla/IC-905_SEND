    {
        "id": "sec_counter_ctl",
        "type": "function",
        "z": "4cecf0f6f013c531",
        "name": "Seconds counter controller",
        "func": "// Boards wired to the two Relay‑5 Clicks\nconst boards = [115, 112];          // 0x70, 0x71\n\nlet timer = context.get('t');\n\nif (msg.topic === 'start') {\n    if (timer) {\n        node.status({fill:'yellow',shape:'dot',text:'already running'});\n        return null;\n    }\n    timer = setInterval(() => {\n        const sec = new Date().getSeconds();\n        for (let i = 0; i < 6; i++) {\n            const bit    = (sec >> i) & 1;\n            const board  = boards[(i < 3) ? 0 : 1];\n            const relay  = (i % 3) + 1;           // 1‑3 each board\n            node.send({\n                address: board,\n                payload: {\n                    relay:  relay,\n                    action: bit ? 'close' : 'open'\n                }\n            });\n        }\n    }, 1000);   // 1 Hz\n    context.set('t', timer);\n    node.status({fill:'green',shape:'dot',text:'running'});\n\n} else if (msg.topic === 'stop') {\n    if (timer) {\n        clearInterval(timer);\n        context.set('t', null);\n        node.status({fill:'red',shape:'ring',text:'stopped'});\n    }\n}\nreturn null;",
