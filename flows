        "type": "function",
        "z": "4cecf0f6f013c531",
        "name": "Relay chaser ON → OFF",
        "func": "// Boards and relays to cycle\nconst boards = [115, 112];        // 0x70, 0x73\nconst relays = [1, 2, 3];          // RL1‑3 (add 4 if wired)\nconst STEP   = 25;                // ms between actions\n\n/* Use the same message format your existing “Build PCA9538A write” node expects:\n      { address: <dec>, payload: {relay:n, action:\"close|open\"} }\n   and fire them with setTimeout so they stream out of this Function\n   at 0.5‑second intervals.                                         */\n\nlet t = 0;\nfor (const addr of boards) {\n    for (const r of relays) {\n        setTimeout(() => {\n            node.send({ address: addr, payload: { relay: r, action: \"close\" } });\n        }, t);\n        t += STEP;\n    }\n}\n\nfor (const addr of boards) {\n    for (const r of relays) {\n        setTimeout(() => {\n            node.send({ address: addr, payload: { relay: r, action: \"open\" } });\n        }, t);\n        t += STEP;\n    }\n}\n\nreturn null;   // we’ve scheduled async sends above",
