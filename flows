    {
        "id": "snake_function",
        "type": "function",
        "z": "4cecf0f6f013c531",
        "name": "Relay 1‑6‑1 chaser",
        "func": "/* Boards (I²C addresses) in physical order */\nconst boards = [115, 112];  // 0x70, 0x71\nconst relays = [1, 2, 3];   // RL1‑3 on each board\nconst STEP   = 25;         // ms between actions\n\n/* Build sequence: 1..6 forward, then 6..1 reverse */\nlet seq = [];\nfor (const b of boards) {\n    for (const r of relays) seq.push({addr: b, relay: r});\n}\nseq = seq.concat([...seq].reverse());  // forward + reverse\n\n/* Schedule messages */\nseq.forEach((item, i) => {\n    const action = (i < boards.length * relays.length) ? \"close\" : \"open\";\n    setTimeout(() => {\n        node.send({\n            address: item.addr,\n            payload: { relay: item.relay, action: action }\n        });\n    }, i * STEP);\n});\nreturn null;   // async sends above",
