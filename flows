        "id": "82db08df4f796f5d",
        "type": "function",
        "z": "040fac9cbf3078bb",
        "name": "decode",
        "func": "// Define the structure/schema clearly\nconst hexSchema = [\n    { name: 'day', offsetFromEnd: 142, length: 2, type: \"string\" },\n    { name: 'month', offsetFromEnd: 140, length: 2, type: \"string\" },\n    { name: 'year', offsetFromEnd: 138, length: 2, type: \"string\" },\n    { name: 'hour', offsetFromEnd: 136, length: 2, type: \"string\" },\n    { name: 'minutes', offsetFromEnd: 134, length: 2, type: \"string\" },\n    { name: 'seconds', offsetFromEnd: 132, length: 2, type: \"string\" },\n    { name: 'bandPrimary', offsetFromEnd: 112, length: 8, type: \"freqOffset\" },\n    { name: 'bandSecondary', offsetFromEnd: 88, length: 8, type: \"freqOffset\" },\n    { name: 'powerLevel', offsetFromEnd: 8, length: 2, type: \"decimal%\"},\n    { name: 'Transmit', offsetFromEnd: 1, length: 1, type: \"boolean\" },\n    // Add more fields as needed\n];\n\nfunction parseHexStructuredByNibble(hexData, schema) {\n    const results = {};\n    const totalNibbles = hexData.length;\n\n    schema.forEach(field => {\n        const startNibble = totalNibbles - field.offsetFromEnd;\n        const endNibble = startNibble + field.length;\n\n        if (startNibble < 0 || endNibble > totalNibbles) {\n            throw new Error(`Field \"${field.name}\" is out of bounds`);\n        }\n\n        const hexSlice = hexData.slice(startNibble, endNibble);\n        let value;\n\n        switch (field.type) {\n            case \"freqOffset\":\n                value = parseInt(hexSlice.match(/.{2}/g).reverse().join(''), 16);\n                if (value < 231000000) {\n                    value = 144;\n                    break;\n                } else if (value < 351000000) {\n                    value = 430;\n                    break;\n                } else if (value < 562000000) {\n                    value = 1200;\n                    break;\n                } else if (value < 963000000) {\n                    value = 2400;\n                    break;\n                } else if (value < 1389000000) {\n                    value = 5600;\n                    break;\n                } else if (value < 1889000001) {\n                    value = 10;\n                    break;\n                }  \n                value = \"N/A\";\n                break;\n            case \"boolean\":\n                value = parseInt(hexSlice, 16) === 1;\n                break;\n            case \"decimal\":\n                value = parseInt(hexSlice, 16);\n                break;\n            case \"decimal%\":\n                value = parseInt(hexSlice, 16);\n                value = Math.round((value / 255) * 100);\n                break;\n            case \"hex\":\n                value = \"0x\" + hexSlice.toUpperCase();\n                break;\n            case \"string\":\n                value = hexSlice;\n                break;\n            case \"stringConvert\":\n                value = hexSlice\n                    .match(/.{1,2}/g)\n                    .map(byte => String.fromCharCode(parseInt(byte, 16)))\n                    .join('');\n                break;\n            default:\n                throw new Error(`Unknown type \"${field.type}\" for field \"${field.name}\"`);\n        }\n\n        results[field.name] = value;\n    });\n\n    return results;\n}\n\nvar cleanedString = msg.payload;\ncleanedString = cleanedString.replace(/[\\r\\n]/g, '');\n\nvar parsedData = parseHexStructuredByNibble(cleanedString, hexSchema);\n// node.warn(parsedData);\n\nmsg.payload = parsedData;\nreturn msg;",
