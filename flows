    {
        "id": "f5403bc71c6f4c38",
        "type": "function",
        "z": "4cecf0f6f013c531",
        "name": "Build PCA9538A write",
        "func": "/* ---------- Relay‑5 Click : build OUTPUT‑register write --------- */\n\n/* Bit masks (bit = 1 → relay closed) */\nconst RL1 = 0x04;      // PCA9538A P2\nconst RL2 = 0x02;      // P1\nconst RL3 = 0x01;      // P0\nconst RL4 = 0x07;      // P3  (spare, if you ever wire it)\n\n/* Which board to hit\n   – Expect msg.address = 0x70‑0x73 (decimal 112‑115)\n   – Default to 0x70 if field missing                                    */\nconst addr = (typeof msg.address === \"number\") ? msg.address : 0x70;\n\n/* Keep a state byte per board */\nconst stateKey = `relayState_${addr}`;\nlet state = flow.get(stateKey) || 0x00;\n\n/* Figure out which bit we’re touching */\nconst r = +msg.payload.relay;          // 1‑4\nconst act = (msg.payload.action || \"\").toLowerCase();\n\nlet bit = (r === 1) ? RL1 :\n  (r === 2) ? RL2 :\n    (r === 3) ? RL3 :\n      (r === 4) ? RL4 : null;\n\nif (bit === null) {\n  node.error(\"relay must be 1‑4\", msg);\n  return null;\n}\n\n/* Update shadow OUTPUT register */\nswitch (act) {\n  case \"close\": state |= bit; break;\n  case \"open\": state &= ~bit; break;\n  case \"toggle\": state ^= bit; break;\n  default:\n    node.error(\"action must be open / close / toggle\", msg);\n    return null;\n}\n\nflow.set(stateKey, state);\n\n/* ---- Build I²C message for the i2c out node ---- */\nmsg.address = addr;   // override the node’s Address field\nmsg.command = 1;      // OUTPUT register 0x01\nmsg.payload = state;  // ONE byte\nmsg.count = 1;      // write 1 byte\n\nreturn msg;",
